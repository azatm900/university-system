    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        maroon: { 50:'#ecfdf5',100:'#d1fae5',200:'#a7f3d0',300:'#6ee7b7',400:'#34d399',500:'#10b981',600:'#059669',700:'#047857',800:'#065f46',900:'#064e3b' },,,,
                        gold: { 400:'#d4af37', 500:'#c5a028' },
                    },
                    fontFamily: { sans: ['Cairo', 'sans-serif'] },
                    animation: {
                        'fade-in': 'fadeIn 0.8s ease-out',
                        'slide-up': 'slideUp 0.8s ease-out',
                        'shake': 'shake 0.5s ease-in-out',
                        'float': 'float 6s ease-in-out infinite',
                    },
                    keyframes: {
                        fadeIn: { '0%': { opacity: '0' }, '100%': { opacity: '1' } },
                        slideUp: { '0%': { opacity: '0', transform: 'translateY(30px)' }, '100%': { opacity: '1', transform: 'translateY(0)' } },
                        shake: { '0%, 100%': { transform: 'translateX(0)' }, '25%': { transform: 'translateX(-5px)' }, '75%': { transform: 'translateX(5px)' } },
                        float: { '0%, 100%': { transform: 'translateY(0)' }, '50%': { transform: 'translateY(-10px)' } },
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Cairo', sans-serif; }
        .bg-pattern {
            background-image: radial-gradient(circle at 20% 50%, rgba(255,255,255,0.05) 0%, transparent 50%),
                              radial-gradient(circle at 80% 80%, rgba(255,255,255,0.05) 0%, transparent 50%);
        }
        .input-focus { transition: all 0.3s ease; }
        .input-focus:focus-within {
            box-shadow: 0 0 0 3px rgba(123, 30, 58, 0.1);
            border-color: #7B1E3A;
        }
        .btn-loading { pointer-events: none; opacity: 0.7; }
        .form-panel::-webkit-scrollbar { width: 6px; }
        .form-panel::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 3px; }
        @media (max-height: 700px) {
            .compact { padding-top: 1rem !important; padding-bottom: 1rem !important; }
            .compact h2 { font-size: 1.5rem !important; }
        }
    
        /* Polish: Responsive + Attractive */
        #loginForm { max-width: 28rem; width: 100%; margin-left: auto; margin-right: auto; }
        .form-panel { background: linear-gradient(160deg, #f9fafb 0%, #ffffff 45%, #f0fdf4 100%); }
        .input-focus:focus-within {
            border-color: #10b981 !important;
            box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.15);
        }
        #submitBtn { transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important; }
        #submitBtn:active { transform: translateY(1px) scale(0.99) !important; }
        @media (max-width: 640px) {
            .form-panel { padding: 1.25rem !important; }
            #loginForm input:not([type='checkbox']), #submitBtn { min-height: 48px; font-size: 16px; }
            .form-panel h2 { font-size: 1.6rem !important; }
        }
        @media (min-width: 1536px) { #loginForm { max-width: 30rem; } }
    </style>
</head>
