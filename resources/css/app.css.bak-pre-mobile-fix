@import 'tailwindcss';

@source '../../vendor/laravel/framework/src/Illuminate/Pagination/resources/views/*.blade.php';
@source '../../storage/framework/views/*.php';
@source '../**/*.blade.php';
@source '../**/*.js';

@theme {
    --font-sans: 'Cairo', 'Segoe UI', Tahoma, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Noto Color Emoji', 'Twemoji Mozilla';

    --color-brand-50:  #f0fdfa;
    --color-brand-100: #ccfbf1;
    --color-brand-200: #99f6e4;
    --color-brand-300: #5eead4;
    --color-brand-400: #2dd4bf;
    --color-brand-500: #14b8a6;
    --color-brand-600: #0d9488;
    --color-brand-700: #0f766e;
    --color-brand-800: #115e59;
    --color-brand-900: #134e4a;

    --color-maroon-50:  #f0fdfa;
    --color-maroon-100: #ccfbf1;
    --color-maroon-200: #99f6e4;
    --color-maroon-300: #5eead4;
    --color-maroon-400: #2dd4bf;
    --color-maroon-500: #14b8a6;
    --color-maroon-600: #0d9488;
    --color-maroon-700: #0f766e;
    --color-maroon-800: #115e59;
    --color-maroon-900: #134e4a;
}

:root {
    --bg: #f8fafc;
    --surface: #ffffff;
    --surface-2: #f1f5f9;
    --border: #e2e8f0;
    --text: #0f172a;
    --text-muted: #64748b;
    --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
    --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.07), 0 2px 4px -2px rgb(0 0 0 / 0.05);
    --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.08), 0 4px 6px -4px rgb(0 0 0 / 0.05);
}
html.dark {
    --bg: #0f172a;
    --surface: #1e293b;
    --surface-2: #334155;
    --border: #334155;
    --text: #f1f5f9;
    --text-muted: #94a3b8;
    --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.3);
    --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.35), 0 2px 4px -2px rgb(0 0 0 / 0.25);
    --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.4), 0 4px 6px -4px rgb(0 0 0 / 0.3);
}

* { border-color: var(--border); }
html, body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Cairo', 'Segoe UI', Tahoma, sans-serif;
    -webkit-font-smoothing: antialiased;
    transition: background-color 0.3s ease, color 0.3s ease;
}

::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
::-webkit-scrollbar-thumb:hover { background: var(--text-muted); }

@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes fadeInUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
@keyframes slideInRight { from { opacity: 0; transform: translateX(20px); } to { opacity: 1; transform: translateX(0); } }

.animate-fade-in { animation: fadeIn 0.25s ease-out; }
.animate-fade-in-up { animation: fadeInUp 0.35s ease-out; }
.animate-slide-in-right { animation: slideInRight 0.35s ease-out; }

.text-muted { color: var(--text-muted); }
.bg-surface { background: var(--surface); }
.bg-surface-2 { background: var(--surface-2); }
.border-default { border-color: var(--border); }

/* Buttons */
.btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
    padding: 0.55rem 1.1rem; border-radius: 0.65rem;
    font-size: 0.875rem; font-weight: 600;
    transition: all 0.2s ease; cursor: pointer;
    border: 1px solid transparent; text-decoration: none; white-space: nowrap;
}
.btn:disabled { opacity: 0.5; cursor: not-allowed; }
.btn:active:not(:disabled) { transform: scale(0.97); }
.btn-primary {
    background: var(--color-brand-600); color: #fff;
    box-shadow: 0 2px 6px rgba(13,148,136,0.25);
}
.btn-primary:hover:not(:disabled) {
    background: var(--color-brand-700);
    box-shadow: 0 4px 12px rgba(13,148,136,0.35);
    transform: translateY(-1px);
}
.btn-secondary { background: var(--surface); color: var(--text); border-color: var(--border); }
.btn-secondary:hover:not(:disabled) { background: var(--surface-2); border-color: var(--color-brand-500); }
.btn-danger { background: #ef4444; color: #fff; }
.btn-danger:hover:not(:disabled) { background: #dc2626; transform: translateY(-1px); }
.btn-ghost { background: transparent; color: var(--text); }
.btn-ghost:hover:not(:disabled) { background: var(--surface-2); }
.btn-sm { padding: 0.35rem 0.75rem; font-size: 0.8rem; }
.btn-lg { padding: 0.75rem 1.5rem; font-size: 1rem; }

/* Cards */
.card { background: var(--surface); border: 1px solid var(--border); border-radius: 1rem; box-shadow: var(--shadow-sm); transition: all 0.2s ease; }
.card:hover { box-shadow: var(--shadow-md); }
.card-body { padding: 1.25rem; }

.stat-card {
    background: var(--surface); border: 1px solid var(--border); border-radius: 1rem;
    padding: 1.25rem; transition: all 0.25s ease; position: relative; overflow: hidden;
}
.stat-card::before {
    content: ''; position: absolute; top: 0; inset-inline-end: 0; width: 80px; height: 80px;
    background: radial-gradient(circle at top right, var(--color-brand-100), transparent 70%);
    opacity: 0.5;
}
html.dark .stat-card::before {
    background: radial-gradient(circle at top right, var(--color-brand-900), transparent 70%);
    opacity: 0.4;
}
.stat-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); border-color: var(--color-brand-400); }

/* Inputs */
.input, .select {
    width: 100%; padding: 0.55rem 0.9rem;
    background: var(--surface); border: 1px solid var(--border); border-radius: 0.65rem;
    color: var(--text); font-size: 0.875rem; transition: all 0.2s ease;
}
.select { cursor: pointer; }
.input:focus, .select:focus {
    outline: none; border-color: var(--color-brand-500);
    box-shadow: 0 0 0 3px rgba(20,184,166,0.15);
}
.input::placeholder { color: var(--text-muted); }

/* Table */
.table { width: 100%; border-collapse: separate; border-spacing: 0; font-size: 0.875rem; }
.table thead th {
    background: var(--surface-2); color: var(--text-muted);
    font-weight: 600; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.03em;
    padding: 0.75rem 1rem; text-align: start; border-bottom: 1px solid var(--border);
}
.table tbody td { padding: 0.85rem 1rem; border-bottom: 1px solid var(--border); color: var(--text); }
.table tbody tr { transition: background 0.15s ease; }
.table tbody tr:hover { background: var(--surface-2); }
.table tbody tr:last-child td { border-bottom: none; }

/* Badge */
.badge {
    display: inline-flex; align-items: center;
    padding: 0.2rem 0.6rem; border-radius: 9999px;
    font-size: 0.7rem; font-weight: 600; line-height: 1.4; white-space: nowrap;
}
.badge-primary { background: var(--color-brand-100); color: var(--color-brand-700); }
.badge-success { background: #dcfce7; color: #166534; }
.badge-warning { background: #fef3c7; color: #92400e; }
.badge-danger { background: #fee2e2; color: #991b1b; }
.badge-neutral { background: var(--surface-2); color: var(--text-muted); }
html.dark .badge-primary { background: rgba(13,148,136,0.2); color: var(--color-brand-300); }
html.dark .badge-success { background: rgba(22,101,52,0.25); color: #86efac; }
html.dark .badge-warning { background: rgba(146,64,14,0.25); color: #fcd34d; }
html.dark .badge-danger { background: rgba(153,27,27,0.25); color: #fca5a5; }

/* Sidebar */
.sidebar {
    background: linear-gradient(180deg, var(--color-brand-800) 0%, var(--color-brand-900) 100%);
    color: #fff; width: 16rem; flex-shrink: 0; display: flex; flex-direction: column;
    transition: width 0.3s ease, transform 0.3s ease;
}
.sidebar-brand {
    padding: 1.25rem 1rem; border-bottom: 1px solid rgba(255,255,255,0.1);
    display: flex; align-items: center; gap: 0.75rem;
}
.sidebar-brand img {
    width: 42px; height: 42px; object-fit: contain;
    background: #fff; border-radius: 10px; padding: 4px; flex-shrink: 0;
}
.sidebar-group-title {
    color: rgba(255,255,255,0.55); font-size: 0.7rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.08em;
    padding: 0 0.75rem; margin-bottom: 0.4rem;
}
.sidebar-link {
    display: flex; align-items: center; gap: 0.65rem;
    padding: 0.55rem 0.75rem; border-radius: 0.55rem;
    color: rgba(255,255,255,0.85); font-size: 0.875rem; font-weight: 500;
    text-decoration: none; transition: all 0.2s ease; position: relative;
}
.sidebar-link:hover { background: rgba(255,255,255,0.08); color: #fff; transform: translateX(-2px); }
html[dir="ltr"] .sidebar-link:hover { transform: translateX(2px); }
.sidebar-link.active { background: rgba(255,255,255,0.15); color: #fff; box-shadow: inset 0 0 0 1px rgba(255,255,255,0.1); }
.sidebar-link.active::before {
    content: ''; position: absolute; inset-inline-end: 0; top: 20%; bottom: 20%;
    width: 3px; background: var(--color-brand-300); border-radius: 3px;
}
.sidebar-link .icon { font-size: 1.1rem; width: 1.5rem; text-align: center; flex-shrink: 0; }

.sidebar.collapsed { width: 4.5rem; }
.sidebar.collapsed .sidebar-brand div > p,
.sidebar.collapsed .sidebar-group-title,
.sidebar.collapsed .sidebar-link .label { display: none; }
.sidebar.collapsed .sidebar-link { justify-content: center; padding: 0.65rem 0.5rem; }

/* ===== G4-ext: Mobile drawer < 768px ===== */
@media (max-width: 767px) {
    .sidebar {
        position: fixed; top: 0; inset-inline-end: 0; height: 100vh; z-index: 50;
        transform: translateX(100%); width: 16rem;
    }
    html[dir="ltr"] .sidebar { transform: translateX(-100%); }
    .sidebar.mobile-open { transform: translateX(0) !important; box-shadow: 0 0 24px rgba(0,0,0,0.3); }
}

/* Navbar */
.navbar {
    background: var(--surface); border-bottom: 1px solid var(--border);
    padding: 0.75rem 1.25rem; display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; box-shadow: var(--shadow-sm); position: sticky; top: 0; z-index: 30;
}
.icon-btn {
    width: 2.5rem; height: 2.5rem; display: inline-flex; align-items: center; justify-content: center;
    border-radius: 0.65rem; background: transparent; color: var(--text-muted); border: none;
    cursor: pointer; transition: all 0.2s ease; position: relative;
}
.icon-btn:hover { background: var(--surface-2); color: var(--color-brand-600); transform: translateY(-1px); }

/* Dropdown */
.dropdown-menu {
    display: none;
    position: absolute; top: calc(100% + 0.5rem); inset-inline-start: 0;
    min-width: 14rem; background: var(--surface); border: 1px solid var(--border);
    border-radius: 0.75rem; box-shadow: var(--shadow-lg); padding: 0.4rem; z-index: 40;
    opacity: 0; visibility: hidden; transform: translateY(-8px); transition: all 0.2s ease;
}
.dropdown-menu.open {
    display: block; opacity: 1; visibility: visible; transform: translateY(0); }
.dropdown-item {
    display: flex; align-items: center; gap: 0.6rem;
    padding: 0.55rem 0.75rem; border-radius: 0.5rem;
    font-size: 0.875rem; color: var(--text); text-decoration: none;
    transition: all 0.15s ease; cursor: pointer; border: none; background: transparent;
    width: 100%; text-align: start;
}
.dropdown-item:hover { background: var(--surface-2); color: var(--color-brand-600); }

/* Toast */
.toast-container {
    position: fixed; top: 1rem; inset-inline-start: 1rem; z-index: 60;
    display: flex; flex-direction: column; gap: 0.6rem; max-width: 24rem;
}
.toast {
    display: flex; align-items: flex-start; gap: 0.65rem;
    padding: 0.85rem 1rem; background: var(--surface); border: 1px solid var(--border);
    border-radius: 0.75rem; box-shadow: var(--shadow-lg);
    animation: slideInRight 0.35s ease-out; position: relative; overflow: hidden;
}
.toast::before { content: ''; position: absolute; top: 0; bottom: 0; inset-inline-end: 0; width: 4px; }
.toast-success::before { background: #10b981; }
.toast-error::before { background: #ef4444; }
.toast-warning::before { background: #f59e0b; }
.toast-close {
    margin-inline-start: auto; background: transparent; border: none;
    cursor: pointer; color: var(--text-muted); padding: 0; font-size: 1.1rem; line-height: 1;
}

/* Backdrop */
.backdrop {
    display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5);
    z-index: 45; backdrop-filter: blur(2px); animation: fadeIn 0.2s ease;
}
.backdrop.show { display: block; }
@media (min-width: 1024px) { .backdrop { display: none !important; } }

/* ===== D+2: Tab active state ===== */
.tab-btn { cursor: pointer; transition: color .15s, border-color .15s; color: var(--text-muted, #6b7280); }
.tab-btn:hover { color: var(--text, #111827); }
.tab-btn.is-active { color: #0d9488; }

/* ===== D+3: Stat-icon base (icon box for stat-card) ===== */
.stat-icon {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

/* ===== D+4: .badge-info (graduated status) ===== */
.badge-info {
    background: rgba(14, 165, 233, 0.15);
    color: #0284c7;
    border: 1px solid rgba(14, 165, 233, 0.30);
}
[data-theme="dark"] .badge-info,
html.dark .badge-info,
.dark .badge-info {
    background: rgba(14, 165, 233, 0.20);
    color: #38bdf8;
    border-color: rgba(14, 165, 233, 0.35);
}
/* ============================================================
   G4-ext: Responsive Enhancements
   ============================================================ */

/* ===== Tablet icon-only (768px – 1023px) ===== */
@media (min-width: 768px) and (max-width: 1023px) {
    .sidebar { width: 4.5rem; }
    .sidebar .label,
    .sidebar .sidebar-brand-text,
    .sidebar .sidebar-group-title > span:not(.sidebar-group-icon),
    .sidebar .sidebar-footer-info { display: none; }
    .sidebar .sidebar-link { justify-content: center; padding: 0.65rem 0.5rem; }
    .sidebar .sidebar-brand { justify-content: center; padding: 0.75rem 0.5rem; }
    .sidebar .sidebar-brand img { width: 36px; height: 36px; }
    .sidebar .sidebar-footer-content { justify-content: center; }
    .sidebar .sidebar-group-title { text-align: center; padding: 0; }
    .sidebar .sidebar-group-icon { display: inline-flex; margin: 0 auto; }
}

/* ===== Mobile touch + tables (<= 767px) ===== */
@media (max-width: 767px) {
    .table-wrapper { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .table-wrapper .table { min-width: 640px; }
    .btn, .icon-btn, .sidebar-link, .dropdown-item { min-height: 44px; }
    .navbar { padding: 0.5rem 0.75rem; }
    .card-body { padding: 1rem; }
    .stat-card { padding: 1rem; }
}

/* ===== Sidebar footer (new — used by sidebar.blade.php) ===== */
.sidebar-footer {
    margin-top: auto;
    padding: 0.75rem 0.75rem 1rem;
    border-top: 1px solid rgba(255,255,255,0.1);
    display: flex; flex-direction: column; gap: 0.4rem;
    flex-shrink: 0;
}
.sidebar-footer-content {
    display: flex; align-items: center; gap: 0.6rem;
    padding: 0.5rem 0.6rem; border-radius: 0.55rem;
    transition: background 0.2s ease;
}
.sidebar-footer-content:hover { background: rgba(255,255,255,0.08); }
.sidebar-footer-avatar {
    width: 2.25rem; height: 2.25rem; border-radius: 50%;
    background: rgba(255,255,255,0.15); color: #fff;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 0.85rem; font-weight: 700; flex-shrink: 0;
}
.sidebar-footer-info { display: flex; flex-direction: column; min-width: 0; line-height: 1.2; }
.sidebar-footer-info .name { color: #fff; font-size: 0.8rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sidebar-footer-info .role { color: rgba(255,255,255,0.55); font-size: 0.7rem; }

/* Sidebar label elements (used inside links) */
.sidebar .label { transition: opacity 0.2s ease; }
.sidebar-brand-text { min-width: 0; }
.sidebar-group-icon { display: inline-flex; align-items: center; justify-content: center; width: 1.5rem; }

/* ===== Backdrop (aligned with layout hidden + show) ===== */
.backdrop {
    opacity: 0; visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    backdrop-filter: blur(2px);
}
.backdrop.show { opacity: 1; visibility: visible; }
@media (min-width: 1024px) { .backdrop { display: none !important; } }

/* ===== Content container safety ===== */
main > .mx-auto { min-width: 0; }
/* ============================================
   Landing Page Styles (Phase G4-ext landing)
   ============================================ */
.landing-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #f0fdfa 0%, #ffffff 50%, #ccfbf1 100%);
    background-size: 200% 200%;
    animation: gradientShift 15s ease infinite;
}
@keyframes gradientShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
}
.landing-hero::before {
    content: '';
    position: absolute;
    top: -10%;
    right: -10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(20,184,166,0.15), transparent 70%);
    border-radius: 50%;
    animation: float 8s ease-in-out infinite;
    pointer-events: none;
}
.landing-hero::after {
    content: '';
    position: absolute;
    bottom: -15%;
    left: -10%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(13,148,136,0.12), transparent 70%);
    border-radius: 50%;
    animation: float 10s ease-in-out infinite reverse;
    pointer-events: none;
}
@keyframes float {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-20px) scale(1.05); }
}
.float-animation {
    animation: float 6s ease-in-out infinite;
}

/* Reveal on scroll */
.reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease, transform 0.8s ease;
}
.reveal.revealed {
    opacity: 1;
    transform: translateY(0);
}

/* Feature cards */
.feature-card {
    background: white;
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 1.75rem;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}
.feature-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, var(--color-brand-500), var(--color-brand-300));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
}
.feature-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px -12px rgba(13,148,136,0.25);
    border-color: var(--color-brand-300);
}
.feature-card:hover::before {
    transform: scaleX(1);
}

/* Stats counter */
.stat-number {
    font-variant-numeric: tabular-nums;
    font-weight: 800;
}

/* Step circles */
.step-circle {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: var(--color-brand-100);
    color: var(--color-brand-700);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 800;
    box-shadow: 0 4px 12px rgba(13,148,136,0.2);
}

/* Landing navbar */
.landing-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition: all 0.3s ease;
}
.landing-nav.scrolled {
    background: rgba(255, 255, 255, 0.98);
    border-bottom-color: var(--border);
    box-shadow: 0 2px 12px rgba(0,0,0,0.05);
}

/* line-clamp for descriptions */
.line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

/* Mobile: hide float animation for performance */
@media (prefers-reduced-motion: reduce) {
    .landing-hero,
    .landing-hero::before,
    .landing-hero::after,
    .float-animation {
        animation: none !important;
    }
    .reveal {
        opacity: 1;
        transform: none;
    }
}

/* ============================================
   Landing Page — Redesign (Colleges + Services)
   ============================================ */

/* Gradient text */
.gradient-text {
    background: linear-gradient(135deg, #0d9488 0%, #14b8a6 50%, #5eead4 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: gradientMove 4s ease infinite;
}
@keyframes gradientMove {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
}

/* Enhanced feature cards with 3D tilt */
.feature-card {
    background: white;
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 1.5rem;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                box-shadow 0.3s ease,
                border-color 0.3s ease;
    position: relative;
    overflow: hidden;
    will-change: transform;
}
.feature-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 4px;
    background: linear-gradient(90deg, var(--color-brand-500), var(--color-brand-300));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}
.feature-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 25px 50px -12px rgba(13, 148, 136, 0.25);
    border-color: var(--color-brand-300);
}
.feature-card:hover::before {
    transform: scaleX(1);
}

/* Service cards hover glow */
.service-card {
    position: relative;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}
.service-card:hover {
    transform: translateY(-6px) scale(1.02);
}

/* Magnetic buttons */
.magnetic-btn {
    transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1),
                box-shadow 0.2s ease;
    will-change: transform;
}

/* Stat numbers enhancement */
.stat-number {
    font-variant-numeric: tabular-nums;
    font-weight: 800;
    background: linear-gradient(180deg, #fff 0%, #ccfbf1 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    text-shadow: 0 0 40px rgba(255, 255, 255, 0.3);
}

/* Step circles with glow */
.step-circle {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-brand-500), var(--color-brand-700));
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 800;
    box-shadow: 0 8px 24px rgba(13, 148, 136, 0.35),
                inset 0 1px 0 rgba(255, 255, 255, 0.2);
    transition: transform 0.3s ease;
}
.step-circle:hover {
    transform: scale(1.1) rotate(-5deg);
}

/* Steps connector line (desktop only) */
@media (min-width: 1024px) {
    .step-circle::after {
        content: '';
        position: absolute;
        top: 50%;
        inset-inline-start: calc(100% + 1rem);
        width: calc(100% - 2rem);
        height: 2px;
        background: linear-gradient(90deg, var(--color-brand-400), transparent);
        z-index: -1;
    }
    .reveal:last-child .step-circle::after {
        display: none;
    }
}

/* Why-us cards */
.why-card {
    transition: all 0.3s ease;
}
.why-card:hover {
    transform: translateX(4px);
}

/* Enhanced responsive — small phones */
@media (max-width: 640px) {
    .landing-hero {
        background-size: 100% 100%;
    }
    .landing-hero::before,
    .landing-hero::after {
        width: 200px;
        height: 200px;
    }
    .float-animation {
        animation-duration: 8s;
    }
    .btn-lg {
        padding: 0.65rem 1.25rem;
        font-size: 0.9rem;
    }
    .gradient-text {
        animation: none;
        background-position: 0% 50%;
    }
}

/* Tablet fine-tuning */
@media (min-width: 641px) and (max-width: 1024px) {
    .feature-card {
        padding: 1.25rem;
    }
}

/* Accessibility: reduce motion */
@media (prefers-reduced-motion: reduce) {
    .landing-hero,
    .landing-hero::before,
    .landing-hero::after,
    .float-animation,
    .gradient-text,
    .step-circle {
        animation: none !important;
        transition: none !important;
    }
    .reveal {
        opacity: 1;
        transform: none;
    }
    .magnetic-btn {
        transition: none;
    }
}

/* Print — hide animations */
@media print {
    .landing-nav,
    .landing-hero::before,
    .landing-hero::after,
    .magnetic-btn {
        display: none;
    }
}
